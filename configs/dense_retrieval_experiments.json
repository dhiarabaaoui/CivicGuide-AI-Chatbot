{
  "schema_version": "1.0.0",
  "experiment_name": "openai_dense_retrieval_v1",
  "implementation_version": "0.1.0",
  "benchmark_id": "multidoc2dial_retrieval_benchmark_v1_e8baf6e2ad",
  "bm25_experiment_id": "bm25_retrieval_baseline_v1_8def866155",
  "development_splits": [
    "train",
    "validation"
  ],
  "locked_splits": [
    "test"
  ],
  "strategies": [
    "fixed_v1",
    "structure_aware_v1",
    "section_preserving_v1",
    "hierarchical_v1"
  ],
  "embedding": {
    "provider": "openai",
    "model": "text-embedding-3-small",
    "dimensions": null,
    "encoding_format": "float",
    "api_key_environment_variable": "OPENAI_API_KEY",
    "dotenv_path": ".env",
    "token_encoding": "cl100k_base",
    "max_input_tokens": 8192,
    "request_batch_size": 128,
    "max_request_tokens": 200000,
    "request_timeout_seconds": 90,
    "max_retries": 6,
    "initial_backoff_seconds": 1.0,
    "maximum_backoff_seconds": 30.0,
    "normalize_l2": true
  },
  "cost_guard": {
    "pricing_as_of": "2026-08-20",
    "input_usd_per_million_tokens": 0.02,
    "pricing_source": "https://developers.openai.com/api/docs/models/text-embedding-3-small",
    "maximum_estimated_new_cost_usd": 1.0
  },
  "cache": {
    "sqlite_filename": "openai_embeddings.sqlite3",
    "validate_cached_vectors": true,
    "commit_each_batch": true
  },
  "evaluation": {
    "similarity": "cosine",
    "search_mode": "exact_numpy",
    "top_k_values": [
      1,
      3,
      5,
      10
    ],
    "query_batch_size": 256,
    "primary_cohort": "direct_user_response",
    "primary_metric": "evidence_recall@5",
    "report_slices": [
      "all_examples",
      "official_primary",
      "overlap_free_primary",
      "short_query_primary",
      "non_short_query_primary",
      "agent_continuation"
    ],
    "persist_validation_rankings": true
  },
  "performance": {
    "latency_sample_size": 500,
    "latency_warmup_queries": 20,
    "random_seed": 42
  }
}
