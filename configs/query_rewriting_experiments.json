{
  "schema_version": "1.0.0",
  "experiment_name": "conditional_query_rewriting_v1",
  "implementation_version": "0.1.0",
  "benchmark_id": "multidoc2dial_retrieval_benchmark_v1_e8baf6e2ad",
  "hybrid_experiment_id": "hybrid_rrf_retrieval_v1_a91b993d86",
  "dense_experiment_id": "openai_dense_retrieval_v1_3b9e048ba8",
  "bm25_experiment_id": "bm25_retrieval_baseline_v1_8def866155",
  "evaluation_split": "validation",
  "locked_splits": [
    "test"
  ],
  "strategy": "section_preserving_v1",
  "cohort": "direct_user_response",
  "gate": {
    "version": "conditional_context_gate_v1",
    "require_non_empty_history": true,
    "rewrite_short_queries": true,
    "rewrite_response_acts": true,
    "context_markers_regex": "\\b(it|its|that|this|these|those|they|them|their|there|then|also|too|he|she|his|her|such|same|former|latter)\\b|^(and|but|so|yes|no|okay|ok|sure|what about|how about)"
  },
  "rewriter": {
    "provider": "openai",
    "api": "responses",
    "model": "gpt-5-mini-2025-08-07",
    "prompt_version": "standalone_retrieval_query_v1",
    "reasoning_effort": "minimal",
    "text_verbosity": "low",
    "max_output_tokens": 128,
    "store": false,
    "history_max_turns": 8,
    "history_max_tokens": 800,
    "token_encoding": "cl100k_base",
    "api_key_environment_variable": "OPENAI_API_KEY",
    "dotenv_path": ".env",
    "request_timeout_seconds": 90,
    "max_retries": 6,
    "initial_backoff_seconds": 1.0,
    "maximum_backoff_seconds": 30.0,
    "concurrency": 6,
    "maximum_rewritten_query_characters": 600,
    "cache_sqlite_filename": "openai_query_rewrites.sqlite3"
  },
  "pricing": {
    "pricing_as_of": "2026-08-20",
    "model_source": "https://developers.openai.com/api/docs/models/gpt-5-mini",
    "responses_input_usd_per_million_tokens": 0.25,
    "responses_cached_input_usd_per_million_tokens": 0.025,
    "responses_output_usd_per_million_tokens": 2.0,
    "embedding_input_usd_per_million_tokens": 0.02,
    "maximum_estimated_new_cost_usd": 1.5
  },
  "embedding": {
    "model": "text-embedding-3-small",
    "dimensions": null,
    "encoding_format": "float",
    "token_encoding": "cl100k_base",
    "max_input_tokens": 8192,
    "request_batch_size": 128,
    "max_request_tokens": 200000,
    "cache_sqlite_filename": "openai_embeddings.sqlite3"
  },
  "retrieval": {
    "base_candidate_depth": 100,
    "persisted_candidate_depth": 100,
    "query_batch_size": 256,
    "hybrid_parameters_source": "selected_parameters_by_strategy",
    "variant_fusion": {
      "method": "weighted_reciprocal_rank_fusion",
      "rank_constant_values": [
        10,
        60
      ],
      "original_weight_values": [
        0.25,
        0.5,
        0.75
      ],
      "rewrite_weight_rule": "one_minus_original_weight"
    }
  },
  "evaluation": {
    "top_k_values": [
      1,
      3,
      5,
      10,
      20,
      50,
      100
    ],
    "primary_selection_metric": "evidence_recall@50",
    "selection_tie_breakers": [
      "evidence_recall@5",
      "mrr@10",
      "weight_balance",
      "standard_rrf_constant"
    ],
    "baseline_parity_tolerance": 0.0001,
    "report_slices": [
      "all_primary",
      "rewrite_gated",
      "rewrite_not_gated",
      "short_queries",
      "non_short_queries",
      "response_acts",
      "overlap_free"
    ]
  },
  "quality_targets": {
    "candidate_recall_at_50_warning_below": 0.85,
    "candidate_recall_at_100_warning_below": 0.9,
    "minimum_valid_rewrite_rate": 0.99
  }
}
